/**
 * מועדון הקריאה — שרת קטן על גוגל שיט
 * לשנות את הקוד למטה לקוד סודי משלך. מי שמכניס אותו באתר יכול לנהל ספרים, הגדרות וחברים.
 */
const ADMIN_PIN = '1234';

const DEFAULT_STATE = {"club":{"name":"מועדון הקריאה","start":"2026-11-11","time":"20:00","weeks":12,"place":""},"members":[],"books":[{"id":"ir0tbaj","title":"השמים שבתוכי","author":"אתי הילסום"}],"meetings":{"0":{"host":"","snacks":"","book":"ir0tbaj","note":"","skip":false}}};
const DEFAULT_COVERS = {"ir0tbaj":"data:image/jpeg;base64,"};

function sheet_(name){const ss=SpreadsheetApp.getActive();return ss.getSheetByName(name)||ss.insertSheet(name)}
function save_(st){sheet_('data').getRange('A1').setValue(JSON.stringify(st))}
function load_(){
  const raw=sheet_('data').getRange('A1').getValue();
  if(!raw){save_(DEFAULT_STATE);Object.keys(DEFAULT_COVERS).forEach(k=>setCover_(k,DEFAULT_COVERS[k]));return JSON.parse(JSON.stringify(DEFAULT_STATE))}
  return JSON.parse(raw);
}
function covers_(){const sh=sheet_('covers'),n=sh.getLastRow(),o={};if(n)sh.getRange(1,1,n,2).getValues().forEach(r=>{if(r[0])o[r[0]]=r[1]});return o}
function setCover_(id,uri){
  const sh=sheet_('covers'),n=sh.getLastRow();
  if(n){const ids=sh.getRange(1,1,n,1).getValues();for(let i=0;i<n;i++){if(ids[i][0]===id){if(uri)sh.getRange(i+1,2).setValue(uri);else sh.deleteRow(i+1);return}}}
  if(uri)sh.appendRow([id,uri]);
}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function full_(extra){const st=load_();return Object.assign({ok:true,state:st,covers:covers_()},extra||{})}

function doGet(){return out_(full_())}

function doPost(e){
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
    const b=JSON.parse(e.postData.contents), st=load_(), admin=String(b.pin||'')===ADMIN_PIN;
    const need=()=>{if(!admin)throw new Error('pin')};
    const s=v=>String(v==null?'':v).slice(0,200);
    const idx=v=>{const i=parseInt(v,10);if(!(i>=0&&i<st.club.weeks))throw new Error('bad week');return i};
    switch(b.action){
      case 'checkPin': return out_({ok:true,admin:admin});
      case 'setMeeting': {const i=idx(b.i),m=st.meetings[i]||{};m.host=s(b.host);m.snacks=s(b.snacks);m.note=s(b.note);
        if(admin){m.skip=!!b.skip;m.book=s(b.book)}st.meetings[i]=m;break}
      case 'fill': (b.items||[]).forEach(x=>{const i=idx(x.i),m=st.meetings[i]||{};if(m.skip)return;if(!m.host&&x.host)m.host=s(x.host);if(!m.snacks&&x.snacks)m.snacks=s(x.snacks);st.meetings[i]=m});break;
      case 'addMember': {const name=s(b.name).trim();if(!name)throw new Error('empty');st.members.push({id:s(b.id),name:name});break}
      case 'removeMember': need();st.members=st.members.filter(p=>p.id!==b.id);Object.keys(st.meetings).forEach(k=>{const m=st.meetings[k];if(m.host===b.id)m.host='';if(m.snacks===b.id)m.snacks=''});break;
      case 'moveMember': {need();const i=st.members.findIndex(p=>p.id===b.id);if(i>0){const t=st.members[i-1];st.members[i-1]=st.members[i];st.members[i]=t}break}
      case 'saveSettings': need();st.club={name:s(b.club.name)||'מועדון הקריאה',start:s(b.club.start),time:s(b.club.time),weeks:Math.max(1,Math.min(104,parseInt(b.club.weeks,10)||12)),place:s(b.club.place)};break;
      case 'addBook': {need();st.books.push({id:s(b.id),title:s(b.title),author:s(b.author)});
        if(b.date!==''&&b.date!=null){const i=idx(b.date);st.meetings[i]=Object.assign({},st.meetings[i]||{},{book:s(b.id)})}break}
      case 'removeBook': need();st.books=st.books.filter(x=>x.id!==b.id);Object.keys(st.meetings).forEach(k=>{if(st.meetings[k].book===b.id)st.meetings[k].book=''});setCover_(b.id,'');break;
      case 'setBookDate': need();Object.keys(st.meetings).forEach(k=>{if(st.meetings[k].book===b.id)st.meetings[k].book=''});
        if(b.date!==''&&b.date!=null){const i=idx(b.date);st.meetings[i]=Object.assign({},st.meetings[i]||{},{book:s(b.id)})}break;
      case 'setCover': need();if(String(b.cover||'').length>49000)throw new Error('too big');setCover_(s(b.id),String(b.cover||''));break;
      default: throw new Error('unknown action');
    }
    save_(st);
    return out_(full_({admin:admin}));
  }catch(err){return out_({ok:false,error:String(err&&err.message||err)})}
  finally{lock.releaseLock()}
}
